# Copy to .env and chmod 600. Generate each secret with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-64-hex-characters
JWT_SECRET_KEY=replace-with-a-different-64-character-random-secret
# IMPORTANT: match the existing database volume on a running host.
POSTGRES_VOLUME_NAME=schimbdecartiromania_postgres_data
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
COMPOSE_PROFILES=demo
# Enable tunnel after configuring a remotely managed Cloudflare Tunnel.
# COMPOSE_PROFILES=tunnel,monitoring
TUNNEL_TOKEN=
# CI publishes immutable commit tags; set this to ghcr.io/OWNER/REPO/backend:SHA
BACKEND_IMAGE=bookexchange-backend:local

PROXY_IMAGE=bookexchange-proxy:local
# Optional email. Leave blank for the free demo; existing SMTP accounts can be used.
# Enable the email profile only after SMTP is configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SSL=false
PUBLIC_BASE_URL=
EMAIL_VERIFICATION_REQUIRED=false
