HEALTH_URL=http://127.0.0.1:8080/health
DISK_PATH=/
# Alert below either threshold; suitable for the small Pi system disk.
DISK_MIN_FREE_PERCENT=5
DISK_MIN_FREE_BYTES=1073741824
# Set after the first verified off-site backup.
# BACKUP_DIR=/home/manumescana/backups/bookexchange
# Optional Discord webhook, stored only in /etc/bookexchange/monitor.env
DISCORD_WEBHOOK_URL=
