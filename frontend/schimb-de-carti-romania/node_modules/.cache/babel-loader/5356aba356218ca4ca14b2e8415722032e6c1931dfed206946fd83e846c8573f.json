{"ast":null,"code":"import axios from \"axios\";\nexport default {\n  data() {\n    return {\n      password: \"\",\n      confirmPassword: \"\",\n      message: \"\",\n      errorMessage: \"\"\n    };\n  },\n  methods: {\n    async resetPassword() {\n      if (this.password !== this.confirmPassword) {\n        this.errorMessage = \"Parolele nu se potrivesc.\";\n        return;\n      }\n      try {\n        const token = this.$route.query.token; // Preia token-ul din URL\n        const response = await axios.post(\"/api/auth/reset-password\", {\n          token,\n          newPassword: this.password\n        });\n        this.message = response.data.message || \"Parola a fost resetată cu succes.\";\n        this.errorMessage = \"\";\n      } catch (error) {\n        console.error(\"Eroare la resetarea parolei:\", error);\n        this.errorMessage = error.response?.data?.error || \"A apărut o eroare. Încearcă din nou.\";\n        this.message = \"\";\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","data","password","confirmPassword","message","errorMessage","methods","resetPassword","token","$route","query","response","post","newPassword","error","console"],"sources":["D:\\SchimbDeCartiRomania (2)\\SchimbDeCartiRomania\\frontend\\schimb-de-carti-romania\\src\\pages\\ResetPasswordPage.vue"],"sourcesContent":["<template>\r\n  <div class=\"reset-password\">\r\n    <h2>Resetare parolă</h2>\r\n    <form @submit.prevent=\"resetPassword\">\r\n      <input\r\n        type=\"password\"\r\n        v-model=\"password\"\r\n        placeholder=\"Parola nouă\"\r\n        required\r\n      />\r\n      <input\r\n        type=\"password\"\r\n        v-model=\"confirmPassword\"\r\n        placeholder=\"Confirmă parola nouă\"\r\n        required\r\n      />\r\n      <button type=\"submit\">Resetează parola</button>\r\n    </form>\r\n    <p v-if=\"message\" class=\"success\">{{ message }}</p>\r\n    <p v-if=\"errorMessage\" class=\"error\">{{ errorMessage }}</p>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from \"axios\";\r\n\r\nexport default {\r\n  data() {\r\n    return {\r\n      password: \"\",\r\n      confirmPassword: \"\",\r\n      message: \"\",\r\n      errorMessage: \"\",\r\n    };\r\n  },\r\n  methods: {\r\n    async resetPassword() {\r\n      if (this.password !== this.confirmPassword) {\r\n        this.errorMessage = \"Parolele nu se potrivesc.\";\r\n        return;\r\n      }\r\n\r\n      try {\r\n        const token = this.$route.query.token; // Preia token-ul din URL\r\n        const response = await axios.post(\"/api/auth/reset-password\", {\r\n          token,\r\n          newPassword: this.password,\r\n        });\r\n        this.message = response.data.message || \"Parola a fost resetată cu succes.\";\r\n        this.errorMessage = \"\";\r\n      } catch (error) {\r\n        console.error(\"Eroare la resetarea parolei:\", error);\r\n        this.errorMessage =\r\n          error.response?.data?.error || \"A apărut o eroare. Încearcă din nou.\";\r\n        this.message = \"\";\r\n      }\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style>\r\n.reset-password {\r\n  max-width: 400px;\r\n  margin: 0 auto;\r\n  text-align: center;\r\n}\r\n\r\ninput {\r\n  display: block;\r\n  width: 100%;\r\n  margin: 10px 0;\r\n  padding: 10px;\r\n}\r\n\r\nbutton {\r\n  padding: 10px 20px;\r\n  background-color: #007bff;\r\n  color: white;\r\n  border: none;\r\n  cursor: pointer;\r\n}\r\n\r\nbutton:hover {\r\n  background-color: #0056b3;\r\n}\r\n\r\n.success {\r\n  color: green;\r\n}\r\n\r\n.error {\r\n  color: red;\r\n}\r\n</style>"],"mappings":"AAwBA,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EAAE;MACZC,eAAe,EAAE,EAAE;MACnBC,OAAO,EAAE,EAAE;MACXC,YAAY,EAAE;IAChB,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,aAAaA,CAAA,EAAG;MACpB,IAAI,IAAI,CAACL,QAAO,KAAM,IAAI,CAACC,eAAe,EAAE;QAC1C,IAAI,CAACE,YAAW,GAAI,2BAA2B;QAC/C;MACF;MAEA,IAAI;QACF,MAAMG,KAAI,GAAI,IAAI,CAACC,MAAM,CAACC,KAAK,CAACF,KA