{"ast":null,"code":"import { getFilterOptions } from '@/services/api';\nexport default {\n  data() {\n    return {\n      filters: {\n        county: 'all',\n        city: 'all',\n        genre: 'all',\n        condition: 'all'\n      },\n      filterOptions: {\n        counties: [],\n        cities: {},\n        genres: [],\n        conditions: []\n      },\n      loading: false\n    };\n  },\n  computed: {\n    availableCities() {\n      if (this.filters.county === 'all' || !this.filterOptions.cities[this.filters.county]) {\n        return [];\n      }\n      return this.filterOptions.cities[this.filters.county] || [];\n    }\n  },\n  methods: {\n    onCountyChange() {\n      this.filters.city = 'all';\n    },\n    applyFilters() {\n      this.$emit('filters-applied', {\n        ...this.filters\n      });\n    },\n    async fetchFilterOptions() {\n      try {\n        this.loading = true;\n        const options = await getFilterOptions();\n        this.filterOptions = options;\n      } catch (error) {\n        console.error('Failed to fetch filter options:', error);\n      } finally {\n        this.loading = false;\n      }\n    }\n  },\n  created() {\n    // Fetch filter options when component is created\n    this.fetchFilterOptions();\n  }\n};","map":{"version":3,"names":["getFilterOptions","data","filters","county","city","genre","condition","filterOptions","counties","cities","genres","conditions","loading","computed","availableCities","methods","onCountyChange","applyFilters","$emit","fetchFilterOptions","options","error","console","created"],"sources":["D:\\SchimbDeCartiRomania (2)\\SchimbDeCartiRomania\\frontend\\schimb-de-carti-romania\\src\\components\\BookFilters.vue"],"sourcesContent":["<template>\n  <div class=\"book-filters\">\n    <h2>Filtrează cărțile</h2>\n    <form @submit.prevent=\"applyFilters\">\n      <div class=\"filters-container\">\n        <div class=\"filter-group\">\n          <label for=\"county\">Județ:</label>\n          <select v-model=\"filters.county\" id=\"county\" @change=\"onCountyChange\">\n            <option value=\"all\">Oricare</option>\n            <option v-for=\"county in filterOptions.counties\" :key=\"county\" :value=\"county\">\n              {{ county }}\n            </option>\n          </select>\n        </div>\n\n        <div class=\"filter-group\">\n          <label for=\"city\">Oraș:</label>\n          <select v-model=\"filters.city\" id=\"city\" :disabled=\"!filters.county || filters.county === 'all'\">\n            <option value=\"all\">Oricare</option>\n            <option v-for=\"city in availableCities\" :key=\"city\" :value=\"city\">\n              {{ city }}\n            </option>\n          </select>\n        </div>\n\n        <div class=\"filter-group\">\n          <label for=\"genre\">Gen carte:</label>\n          <select v-model=\"filters.genre\" id=\"genre\">\n            <option value=\"all\">Oricare</option>\n            <option v-for=\"genre in filterOptions.genres\" :key=\"genre\" :value=\"genre\">\n              {{ genre }}\n            </option>\n          </select>\n        </div>\n\n        <div class=\"filter-group\">\n          <label for=\"condition\">Stare carte:</label>\n          <select v-model=\"filters.condition\" id=\"condition\">\n            <option value=\"all\">Oricare</option>\n            <option v-for=\"condition in filterOptions.conditions\" :key=\"condition\" :value=\"condition\">\n              {{ condition }}\n            </option>\n          </select>\n        </div>\n      </div>\n\n      <button type=\"submit\" class=\"apply-filters-btn\">Aplică filtre</button>\n    </form>\n  </div>\n</template>\n\n<script>\nimport { getFilterOptions } from '@/services/api';\n\nexport default {\n  data() {\n    return {\n      filters: {\n        county: 'all',\n        city: 'all',\n        genre: 'all',\n        condition: 'all',\n      },\n      filterOptions: {\n        counties: [],\n        cities: {},\n        genres: [],\n        conditions: []\n      },\n      loading: false\n    };\n  },\n  computed: {\n    availableCities() {\n      if (this.filters.county === 'all' || !this.filterOptions.cities[this.filters.county]) {\n        return [];\n      }\n      return this.filterOptions.cities[this.filters.county] || [];\n    }\n  },\n  methods: {\n    onCountyChange() {\n      this.filters.city = 'all';\n    },\n    applyFilters() {\n      this.$emit('filters-applied', { ...this.filters });\n    },\n    async fetchFilterOptions() {\n      try {\n        this.loading = true;\n        const options = await getFilterOptions();\n        this.filterOptions = options;\n      } catch (error) {\n        console.error('Failed to fetch filter options:', error);\n      } finally {\n        this.loading = false;\n      }\n    }\n  },\n  created() {\n    // Fetch filter options when component is created\n    this.fetchFilterOptions();\n  }\n};\n</script>\n\n<style scoped>\n.filters-container {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 20px;\n}\n\n.filter-group {\n  display: flex;\n  flex-direction: column;\n  min-width: 150px;\n}\n\n</style>"],"mappings":"AAoDA,SAASA,gBAAe,QAAS,gBAAgB;AAEjD,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,OAAO,EAAE;QACPC,MAAM,EAAE,KAAK;QACbC,IAAI,EAAE,KAAK;QACXC,KAAK,EAAE,KAAK;QACZC,SAAS,EAAE;MACb,CAAC;MACDC,aAAa,EAAE;QACbC,QAAQ,EAAE,EAAE;QACZC,MAAM,EAAE,CAAC,CAAC;QACVC,MAAM,EAAE,EAAE;QACVC,UAAU,EAAE;MACd,CAAC;MACDC,OAAO,EAAE;IACX,CAAC;EACH,CAAC;EACDC,QAAQ,EAAE;IACRC,eAAeA,CAAA,EAAG;MAChB,IAAI,IAAI,CAACZ,OAAO,CAACC,MAAK,KAAM,KAAI,IAAK,CAAC,IAAI,CAACI,aAAa,CAACE,MAAM,CAAC,IAAI,CAACP,OAAO,CAACC,MAAM,CAAC,EAAE;QACpF,OAAO,EAAE;MACX;MACA,OAAO,IAAI,CAACI,aAAa,CAACE,MAAM,CAAC,IAAI,CAACP,OAAO,CAACC,MAAM,KAAK,EAAE;IAC7D;EACF,CAAC;EACDY,OAAO,EAAE;IACPC,cAAcA,CAAA,EAAG;MACf,IAAI,CAACd,OAAO,CAACE,IAAG,GAAI,KAAK;IAC3B,CAAC;IACDa,YAAYA,CAAA,EAAG;MACb,IAAI,CAACC,KAAK,CAAC,iBAAiB,EAAE;QAAE,GAAG,IAAI,CAAChB;MAAQ,CAAC,CAAC;IACpD,CAAC;IACD,MAAMiB,kBAAkBA,CAAA,EAAG;MACzB,IAAI;QACF,IAAI,CAACP,OAAM,GAAI,