{"ast":null,"code":"export default {\n  name: 'SeeRequestPopup',\n  props: {\n    request: Object\n  },\n  data() {\n    return {\n      requesterUser: null\n    };\n  },\n  mounted() {\n    this.fetchRequesterInfo();\n  },\n  methods: {\n    async fetchRequesterInfo() {\n      // Înlocuiește acest mock cu o cerere API reală sau un store global\n      const mockUsers = [{\n        id: 1,\n        name: 'Ion Popescu',\n        contactMethod: 'WhatsApp: 123456789'\n      }, {\n        id: 2,\n        name: 'Maria Ionescu',\n        contactMethod: 'Email: maria@example.com'\n      }];\n      this.requesterUser = mockUsers.find(u => u.id === this.request.requesterId);\n    },\n    approveRequest() {\n      alert('Cerere aprobată!');\n      this.close();\n    },\n    rejectRequest() {\n      alert('Cerere respinsă!');\n      this.close();\n    },\n    close() {\n      this.$emit('close');\n    }\n  }\n};","map":{"version":3,"names":["name","props","request","Object","data","requesterUser","mounted","fetchRequesterInfo","methods","mockUsers","id","contactMethod","find","u","requesterId","approveRequest","alert","close","rejectRequest","$emit"],"sources":["D:\\SchimbDeCartiRomania (2)\\SchimbDeCartiRomania\\frontend\\schimb-de-carti-romania\\src\\components\\SeeRequestPopup.vue"],"sourcesContent":["<template>\n  <div class=\"overlay\" @click.self=\"close\">\n    <div class=\"modal\">\n      <button class=\"close-btn\" @click=\"close\">×</button>\n      <h2>Cerere de Schimb</h2>\n\n      <div class=\"info-box\">\n        <p><strong>Cartea vizată:</strong> {{ request.bookTitle }}</p>\n        <p><strong>Cerută de:</strong>\n          <router-link :to=\"'/profile/' + request.requesterId\">{{ request.requester }}</router-link>\n        </p>\n        <p><strong>Metodă de contact:</strong> {{ requesterUser?.contactMethod || 'Necunoscută' }}</p>\n        <p><strong>Mesaj:</strong> {{ request.message }}</p>\n        <p><strong>Cărți oferite:</strong></p>\n        <ul>\n          <li v-for=\"book in request.offeredBooks\" :key=\"book.id\">{{ book.title }}</li>\n        </ul>\n      </div>\n\n      <div class=\"actions\">\n        <button class=\"approve-btn\" @click=\"approveRequest\">Aprobă</button>\n        <button class=\"reject-btn\" @click=\"rejectRequest\">Respinge</button>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'SeeRequestPopup',\n  props: {\n    request: Object,\n  },\n  data() {\n    return {\n      requesterUser: null,\n    };\n  },\n  mounted() {\n    this.fetchRequesterInfo();\n  },\n  methods: {\n    async fetchRequesterInfo() {\n      // Înlocuiește acest mock cu o cerere API reală sau un store global\n      const mockUsers = [\n        {\n          id: 1,\n          name: 'Ion Popescu',\n          contactMethod: 'WhatsApp: 123456789',\n        },\n        {\n          id: 2,\n          name: 'Maria Ionescu',\n          contactMethod: 'Email: maria@example.com',\n        },\n      ];\n\n      this.requesterUser = mockUsers.find(\n        (u) => u.id === this.request.requesterId\n      );\n    },\n    approveRequest() {\n      alert('Cerere aprobată!');\n      this.close();\n    },\n    rejectRequest() {\n      alert('Cerere respinsă!');\n      this.close();\n    },\n    close() {\n      this.$emit('close');\n    },\n  },\n};\n</script>\n\n<style scoped>\n.overlay {\n  position: fixed;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  background: rgba(0, 0, 0, 0.4);\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  z-index: 1000;\n}\n\n.modal {\n  position: relative;\n  background: white;\n  border-radius: 16px;\n  padding: 30px;\n  width: 90%;\n  max-width: 600px;\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);\n}\n\n.close-btn {\n  position: absolute;\n  top: 12px;\n  right: 16px;\n  font-size: 24px;\n  background: none;\n  border: none;\n  cursor: pointer;\n}\n\n.info-box p {\n  margin: 10px 0;\n}\n\n.actions {\n  display: flex;\n  justify-content: space-between;\n  margin-top: 30px;\n}\n\n.approve-btn,\n.reject-btn {\n  padding: 10px 20px;\n  font-weight: bold;\n  border-radius: 8px;\n  border: none;\n  cursor: pointer;\n}\n\n.approve-btn {\n  background-color: #4caf50;\n  color: white;\n}\n\n.reject-btn {\n  background-color: #f44336;\n  color: white;\n}\n</style>\n"],"mappings":"AA4BA,eAAe;EACbA,IAAI,EAAE,iBAAiB;EACvBC,KAAK,EAAE;IACLC,OAAO,EAAEC;EACX,CAAC;EACDC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,aAAa,EAAE;IACjB,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,kBAAkB,CAAC,CAAC;EAC3B,CAAC;EACDC,OAAO,EAAE;IACP,MAAMD,kBAAkBA,CAAA,EAAG;MACzB;MACA,MAAME,SAAQ,GAAI,CAChB;QACEC,EAAE,EAAE,CAAC;QACLV,IAAI,EAAE,aAAa;QACnBW,aAAa,EAAE;MACjB,CAAC,EACD;QACED,EAAE,EAAE,CAAC;QACLV,IAAI,EAAE,eAAe;QACrBW,aAAa,EAAE;MACjB,CAAC,CACF;MAED,IAAI,CAACN,aAAY,GAAII,SAAS,CAACG,IAAI,CAChCC,CAAC,IAAKA,CAAC,CAACH,EAAC,KAAM,IAAI,CAACR,OAAO,CAACY,WAC/B,CAAC;IACH,CAAC;IACDC,cAAcA,CAAA,EAAG;MACfC,KAAK,CAAC,kBAAkB,CAAC;MACzB,IAAI,CAACC,KAAK,CAAC,CAAC;IACd,CAAC;IACDC,aAAaA,CAAA,EAAG;MACdF,KAAK,CAAC,kBAAkB,CAAC;MACzB,IAAI,CAACC,KAAK,CAAC,CAAC;IACd,CAAC;IACDA,KAAKA,CAAA,EAAG;MACN,IAAI,CAACE,KAAK,CAAC,OAAO,CAAC;IACrB;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}