{"ast":null,"code":"export default {\n  name: 'PublicProfilePage',\n  data() {\n    return {\n      user: {\n        username: '',\n        email: '',\n        books: []\n      }\n    };\n  },\n  created() {\n    const userId = this.$route.params.id;\n    this.fetchUser(userId);\n  },\n  methods: {\n    fetchUser(id) {\n      // Mock user + cărți. În realitate faci un API call aici.\n      const allUsers = [{\n        id: 123,\n        username: 'user1',\n        email: 'user1@email.com',\n        books: [{\n          id: 1,\n          title: 'Cartea 1',\n          author: 'Autor 1',\n          imageUrl: 'https://via.placeholder.com/150'\n        }, {\n          id: 3,\n          title: 'Cartea 3',\n          author: 'Autor 3',\n          imageUrl: 'https://via.placeholder.com/150'\n        }]\n      }, {\n        id: 124,\n        username: 'user2',\n        email: 'user2@email.com',\n        books: []\n      }];\n      const found = allUsers.find(u => u.id == id);\n      if (found) this.user = found;\n    },\n    proposeExchange(bookId) {\n      alert(`Ai propus schimbul pentru cartea #${bookId}`);\n    }\n  }\n};","map":{"version":3,"names":["name","data","user","username","email","books","created","userId","$route","params","id","fetchUser","methods","allUsers","title","author","imageUrl","found","find","u","proposeExchange","bookId","alert"],"sources":["D:\\SchimbDeCartiRomania (2)\\SchimbDeCartiRomania\\frontend\\schimb-de-carti-romania\\src\\pages\\PublicProfilePage.vue"],"sourcesContent":["<template>\n  <div class=\"profile\">\n    <h2>Profilul lui {{ user.username }}</h2>\n    <p><strong>Email:</strong> {{ user.email }}</p>\n\n    <h3>Cărți postate:</h3>\n    <div v-if=\"user.books.length\">\n      <div v-for=\"book in user.books\" :key=\"book.id\" class=\"book-card\">\n        <img :src=\"book.imageUrl\" alt=\"carte\" />\n        <p><strong>{{ book.title }}</strong> de {{ book.author }}</p>\n        <router-link :to=\"'/book/' + book.id\">Vezi detalii</router-link>\n        <button @click=\"proposeExchange(book.id)\">Propune schimbul</button>\n      </div>\n    </div>\n    <div v-else>\n      <p>Acest utilizator nu a postat nicio carte.</p>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'PublicProfilePage',\n  data() {\n    return {\n      user: {\n        username: '',\n        email: '',\n        books: []\n      }\n    };\n  },\n  created() {\n    const userId = this.$route.params.id;\n    this.fetchUser(userId);\n  },\n  methods: {\n    fetchUser(id) {\n      // Mock user + cărți. În realitate faci un API call aici.\n      const allUsers = [\n        {\n          id: 123,\n          username: 'user1',\n          email: 'user1@email.com',\n          books: [\n            { id: 1, title: 'Cartea 1', author: 'Autor 1', imageUrl: 'https://via.placeholder.com/150' },\n            { id: 3, title: 'Cartea 3', author: 'Autor 3', imageUrl: 'https://via.placeholder.com/150' }\n          ]\n        },\n        {\n          id: 124,\n          username: 'user2',\n          email: 'user2@email.com',\n          books: []\n        }\n      ];\n\n      const found = allUsers.find(u => u.id == id);\n      if (found) this.user = found;\n    },\n    proposeExchange(bookId) {\n      alert(`Ai propus schimbul pentru cartea #${bookId}`);\n    }\n  }\n};\n</script>\n\n<style scoped>\n.profile {\n  padding: 20px;\n}\n\n.book-card {\n  margin: 10px 0;\n  padding: 10px;\n  border: 1px solid #ccc;\n}\n\n.book-card img {\n  width: 100px;\n  height: auto;\n  border-radius: 5px;\n}\n</style>\n"],"mappings":"AAqBA,eAAe;EACbA,IAAI,EAAE,mBAAmB;EACzBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,IAAI,EAAE;QACJC,QAAQ,EAAE,EAAE;QACZC,KAAK,EAAE,EAAE;QACTC,KAAK,EAAE;MACT;IACF,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,MAAMC,MAAK,GAAI,IAAI,CAACC,MAAM,CAACC,MAAM,CAACC,EAAE;IACpC,IAAI,CAACC,SAAS,CAACJ,MAAM,CAAC;EACxB,CAAC;EACDK,OAAO,EAAE;IACPD,SAASA,CAACD,EAAE,EAAE;MACZ;MACA,MAAMG,QAAO,GAAI,CACf;QACEH,EAAE,EAAE,GAAG;QACPP,QAAQ,EAAE,OAAO;QAC