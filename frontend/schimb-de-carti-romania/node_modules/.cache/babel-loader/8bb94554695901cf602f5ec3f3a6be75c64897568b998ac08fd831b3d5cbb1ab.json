{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { registerUser } from '@/services/auth';\nexport default {\n  name: 'SignUpPage',\n  data() {\n    return {\n      name: '',\n      email: '',\n      password: '',\n      confirmPassword: '',\n      error: '',\n      loading: false\n    };\n  },\n  methods: {\n    async signup() {\n      if (this.password !== this.confirmPassword) {\n        this.error = 'Parolele nu se potrivesc. Te rog încearcă din nou.';\n        return;\n      }\n      this.error = '';\n      this.loading = true;\n      try {\n        await registerUser({\n          name: this.name,\n          email: this.email,\n          password: this.password\n        });\n        this.$router.push('/'); // Redirecționează la pagina principală după înregistrare\n      } catch (error) {\n        if (error.response && error.response.data) {\n          this.error = error.response.data.error || 'Înregistrare eșuată';\n        } else {\n          this.error = 'A apărut o eroare. Te rugăm să încerci din nou.';\n        }\n      } finally {\n        this.loading = false;\n      }\n    }\n  }\n};","map":{"version":3,"names":["registerUser","name","data","email","password","confirmPassword","error","loading","methods","signup","$router","push","response"],"sources":["D:\\SchimbDeCartiRomania (2)\\SchimbDeCartiRomania\\frontend\\schimb-de-carti-romania\\src\\pages\\SignUpPage.vue"],"sourcesContent":["<template>\n  <div class=\"signup-page\">\n    <h1>Înregistrare</h1>\n    <form @submit.prevent=\"signup\" class=\"signup-form\">\n      <div class=\"form-group\">\n        <label for=\"name\">Nume</label>\n        <input\n          type=\"text\"\n          id=\"name\"\n          v-model=\"name\"\n          placeholder=\"Introdu numele tău\"\n          required\n        />\n      </div>\n\n      <div class=\"form-group\">\n        <label for=\"email\">Email</label>\n        <input\n          type=\"email\"\n          id=\"email\"\n          v-model=\"email\"\n          placeholder=\"Introdu email-ul\"\n          required\n        />\n      </div>\n\n      <div class=\"form-group\">\n        <label for=\"password\">Parolă</label>\n        <input\n          type=\"password\"\n          id=\"password\"\n          v-model=\"password\"\n          placeholder=\"Introdu parola\"\n          required\n        />\n      </div>\n\n      <div class=\"form-group\">\n        <label for=\"confirmPassword\">Confirmă Parola</label>\n        <input\n          type=\"password\"\n          id=\"confirmPassword\"\n          v-model=\"confirmPassword\"\n          placeholder=\"Confirmă parola\"\n          required\n        />\n      </div>\n\n      <div class=\"form-group\">\n        <button type=\"submit\" :disabled=\"loading\">\n          {{ loading ? 'Se procesează...' : 'Înregistrează-te' }}\n        </button>\n      </div>\n\n      <p v-if=\"error\" class=\"error\">{{ error }}</p>\n    </form>\n    <p>Ai deja un cont? <router-link to=\"/login\">Autentifică-te aici</router-link></p>\n  </div>\n</template>\n\n<script>\nimport { registerUser } from '@/services/auth';\n\nexport default {\n  name: 'SignUpPage',\n  data() {\n    return {\n      name: '',\n      email: '',\n      password: '',\n      confirmPassword: '',\n      error: '',\n      loading: false\n    };\n  },\n  methods: {\n    async signup() {\n      if (this.password !== this.confirmPassword) {\n        this.error = 'Parolele nu se potrivesc. Te rog încearcă din nou.';\n        return;\n      }\n\n      this.error = '';\n      this.loading = true;\n      \n      try {\n        await registerUser({\n          name: this.name,\n          email: this.email,\n          password: this.password\n        });\n        this.$router.push('/'); // Redirecționează la pagina principală după înregistrare\n      } catch (error) {\n        if (error.response && error.response.data) {\n          this.error = error.response.data.error || 'Înregistrare eșuată';\n        } else {\n          this.error = 'A apărut o eroare. Te rugăm să încerci din nou.';\n        }\n      } finally {\n        this.loading = false;\n      }\n    },\n  },\n};\n</script>\n\n<style scoped>\n.signup-page {\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  align-items: center;\n  height: 100vh;\n  background-color: #f9f9f9;\n}\n\nh1 {\n  color: #333;\n  margin-bottom: 20px;\n}\n\n.signup-form {\n  width: 100%;\n  max-width: 400px;\n  background-color: white;\n  padding: 20px;\n  border-radius: 8px;\n  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);\n}\n\n.form-group {\n  margin-bottom: 16px;\n}\n\n.form-group label {\n  display: block;\n  font-weight: bold;\n  color: #333;\n}\n\n.form-group input {\n  width: 100%;\n  padding: 12px;\n  margin-top: 6px;\n  border: 1px solid #ccc;\n  border-radius: 4px;\n}\n\nbutton {\n  width: 100%;\n  padding: 12px;\n  background-color: #28a745;\n  color: white;\n  border: none;\n  border-radius: 4px;\n  cursor: pointer;\n  transition: background-color 0.3s;\n}\n\nbutton:hover {\n  background-color: #218838;\n}\n\nbutton:disabled {\n  background-color: #ccc;\n  cursor: not-allowed;\n}\n\n.error {\n  color: red;\n  margin-top: 10px;\n}\n</style>\n"],"mappings":";AA6DA,SAASA,YAAW,QAAS,iBAAiB;AAE9C,eAAe;EACbC,IAAI,EAAE,YAAY;EAClBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLD,IAAI,EAAE,EAAE;MACRE,KAAK,EAAE,EAAE;MACTC,QAAQ,EAAE,EAAE;MACZC,eAAe,EAAE,EAAE;MACnBC,KAAK,EAAE,EAAE;MACTC,OAAO,EAAE;IACX,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,MAAMA,CAAA,EAAG;MACb,IAAI,IAAI,CAACL,QAAO,KAAM,IAAI,CAACC,eAAe,EAAE;QAC1C,IAAI,CAACC,KAAI,GAAI,oDAAoD;QACjE;MACF;MAEA,IAAI,CAACA,KAAI,GAAI,EAAE;MACf,IAAI,CAACC,OAAM,GAAI,IAAI;MAEnB,IAAI;QACF,MAAMP,YAAY,CAAC;UACjBC,IAAI,EAAE,IAAI,CAACA,IAAI;UACfE,KAAK,EAAE,IAAI,CAACA,KAAK;UACjBC,QAAQ,EAAE,IAAI,CAACA;QACjB,CAAC,CAAC;QACF,IAAI,CAACM,OAAO,CAACC,IAAI,CAAC,GAAG,CAAC,EAAE;MAC1B,EAAE,OAAOL,KAAK,EAAE;QACd,IAAIA,KAAK,CAACM,QAAO,IAAKN,KAAK,CAACM,QAAQ,CAACV,IAAI,EAAE;UACzC,IAAI,CAACI,KAAI,GAAIA,KAAK,CAACM,QAAQ,CAACV,