{"ast":null,"code":"import axios from 'axios';\nexport default {\n  data() {\n    return {\n      email: '',\n      message: '',\n      errorMessage: ''\n    };\n  },\n  methods: {\n    async recover() {\n      try {\n        // Trimite cererea către backend\n        const response = await axios.post('/api/auth/forgot-password', {\n          email: this.email\n        });\n        this.message = response.data.message || 'Dacă adresa există, vei primi un email.';\n        this.errorMessage = ''; // Resetează mesajul de eroare\n      } catch (error) {\n        console.error('Error in recover:', error);\n        this.errorMessage = error.response?.data?.error || 'A apărut o eroare. Încearcă din nou.';\n        this.message = ''; // Resetează mesajul de succes\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","data","email","message","errorMessage","methods","recover","response","post","error","console"],"sources":["D:\\SchimbDeCartiRomania (2)\\SchimbDeCartiRomania\\frontend\\schimb-de-carti-romania\\src\\pages\\ForgotPasswordPage.vue"],"sourcesContent":["<template>\n  <div class=\"forgot-password\">\n    <h2>Recuperare parolă</h2>\n    <form @submit.prevent=\"recover\">\n      <input type=\"email\" v-model=\"email\" placeholder=\"Emailul tău\" required />\n      <button type=\"submit\">Trimite link de resetare</button>\n    </form>\n    <p v-if=\"message\">{{ message }}</p>\n    <p v-if=\"errorMessage\" class=\"error\">{{ errorMessage }}</p>\n  </div>\n</template>\n\n<script>\nimport axios from 'axios';\n\nexport default {\n  data() {\n    return {\n      email: '',\n      message: '',\n      errorMessage: ''\n    }\n  },\n  methods: {\n    async recover() {\n      try {\n        // Trimite cererea către backend\n        const response = await axios.post('/api/auth/forgot-password', { email: this.email });\n        this.message = response.data.message || 'Dacă adresa există, vei primi un email.';\n        this.errorMessage = ''; // Resetează mesajul de eroare\n      } catch (error) {\n        console.error('Error in recover:', error);\n        this.errorMessage = error.response?.data?.error || 'A apărut o eroare. Încearcă din nou.';\n        this.message = ''; // Resetează mesajul de succes\n      }\n    }\n  }\n}\n</script>\n\n<style>\n.error {\n  color: red;\n}\n</style>"],"mappings":"AAaA,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,KAAK,EAAE,EAAE;MACTC,OAAO,EAAE,EAAE;MACXC,YAAY,EAAE;IAChB;EACF,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,OAAOA,CAAA,EAAG;MACd,IAAI;QACF;QACA,MAAMC,QAAO,GAAI,MAAMP,KAAK,CAACQ,IAAI,CAAC,2BAA2B,EAAE;UAAEN,KAAK,EAAE,IAAI,CAACA;QAAM,CAAC,CAAC;QACrF,IAAI,CAACC,OAAM,GAAII,QAAQ,CAACN,IAAI,CAACE,OAAM,IAAK,yCAAyC;QACjF,IAAI,CAACC,YAAW,GAAI,EAAE,EAAE;MAC1B,EAAE,OAAOK,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,mBAAmB,EAAEA,KAAK,CAAC;QACzC,IAAI,CAACL,YAAW,GAAIK,KAAK,CAACF,QAAQ,EAAEN,IAAI,EAAEQ,KAAI,IAAK,sCAAsC;QACzF,IAAI,CAACN,OAAM,GAAI,EAAE,EAAE;MACrB;IACF;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}